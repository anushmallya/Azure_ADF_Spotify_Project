{
	"name": "pipeline1",
	"properties": {
		"activities": [
			{
				"name": "Last_update_Lookup",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "last_updatejson_lookup_source",
						"type": "DatasetReference",
						"parameters": {
							"p_folder_1": {
								"value": "@pipeline().parameters.p_table",
								"type": "Expression"
							},
							"p_folder_2": {
								"value": "@{pipeline().parameters.p_table}_monitor",
								"type": "Expression"
							},
							"p_file": {
								"value": "@{pipeline().parameters.p_table}_last_update.json",
								"type": "Expression"
							}
						}
					}
				}
			},
			{
				"name": "Current_date",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "V_date",
					"value": {
						"value": "@utcNow()",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Max_date_lookup",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT \n    MAX(@{pipeline().parameters.p_column}) as 'latest_update'\nFROM @{pipeline().parameters.p_schema}.@{pipeline().parameters.p_table}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "Sql_table_max_date",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Copy_SQL_Data_Parquet_file",
				"type": "Copy",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Last_update_Lookup",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Current_date",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Max_date_lookup",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT\n    *\nFROM @{pipeline().parameters.p_schema}.@{pipeline().parameters.p_table}\nWHERE @{pipeline().parameters.p_column} > @{activity('Last_update_Lookup').output.firstRow.last_update} AND @{pipeline().parameters.p_column} < '@{activity('Max_date_lookup').output.value[0].last_update}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "SQL_Data_source",
						"type": "DatasetReference"
					}
				]
			}
		],
		"parameters": {
			"p_schema": {
				"type": "string"
			},
			"p_table": {
				"type": "string"
			},
			"p_column": {
				"type": "string"
			}
		},
		"variables": {
			"V_date": {
				"type": "String"
			}
		},
		"annotations": []
	}
}