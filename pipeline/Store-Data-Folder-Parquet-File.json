{
	"name": "Store-Data-Folder-Parquet-File",
	"properties": {
		"activities": [
			{
				"name": "Last_update_lookup",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "Last_update_lookup_source",
						"type": "DatasetReference",
						"parameters": {
							"p_folder_1": {
								"value": "@pipeline().parameters.p_table",
								"type": "Expression"
							},
							"p_folder_2": {
								"value": "@{pipeline().parameters.p_table}_monitor",
								"type": "Expression"
							},
							"p_file": {
								"value": "@{pipeline().parameters.p_table}_last_update.json",
								"type": "Expression"
							}
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "max_date_lookup",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT\n    MAX(@{pipeline().parameters.p_column}) as latest_update\nFROM @{pipeline().parameters.p_schema}.@{pipeline().parameters.p_table}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "max_date_table_source",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "current_date",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "v_date",
					"value": {
						"value": "@utcNow()",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Copy_sql_storage",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Last_update_lookup",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "current_date",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "max_date_lookup",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT\n    *\nFROM @{pipeline().parameters.p_schema}.@{pipeline().parameters.p_table}\nWHERE @{pipeline().parameters.p_column} > '@{activity('Last_update_lookup').output.value[0].last_update}' AND @{pipeline().parameters.p_column} <= '@{activity('max_date_lookup').output.value[0].latest_update}' ",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "Sql_Data_Storage_Source",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "SQL_Data_Parquet_Storage_Sink",
						"type": "DatasetReference",
						"parameters": {
							"p_folder_1": {
								"value": "@pipeline().parameters.p_table",
								"type": "Expression"
							},
							"p_folder_2": {
								"value": "@{pipeline().parameters.p_table}_data",
								"type": "Expression"
							},
							"p_file": {
								"value": "@concat(pipeline().parameters.p_table,'-',variables('v_date'))",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"parameters": {
			"p_schema": {
				"type": "string"
			},
			"p_table": {
				"type": "string"
			},
			"p_column": {
				"type": "string"
			}
		},
		"variables": {
			"v_date": {
				"type": "String"
			}
		},
		"annotations": []
	}
}