		{
			"name": "[concat(parameters('factoryName'), '/update_last_update_sink')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ADF_Storage_Link",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"p_folder_1": {
						"type": "string"
					},
					"p_folder_2": {
						"type": "string"
					},
					"p_file": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
