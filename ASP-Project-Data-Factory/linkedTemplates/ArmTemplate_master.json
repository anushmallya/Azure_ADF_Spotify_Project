{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ASP-Project-Data-Factory"
		},
		"ADF_SQL_Database_Link_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ADF_SQL_Database_Link'"
		},
		"ADF_Storage_Link_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ADF_Storage_Link'"
		},
		"ADF_SQL_Database_Link_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "aspserver.database.windows.net"
		},
		"ADF_SQL_Database_Link_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "ASP-DataBase"
		},
		"ADF_SQL_Database_Link_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "aspadmin"
		},
		"ADF_Storage_Link_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://asprojectstorageaccount.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ASP-Project-Data-Factory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ADF_SQL_Database_Link_password": {
						"value": "[parameters('ADF_SQL_Database_Link_password')]"
					},
					"ADF_Storage_Link_accountKey": {
						"value": "[parameters('ADF_Storage_Link_accountKey')]"
					},
					"ADF_SQL_Database_Link_properties_typeProperties_server": {
						"value": "[parameters('ADF_SQL_Database_Link_properties_typeProperties_server')]"
					},
					"ADF_SQL_Database_Link_properties_typeProperties_database": {
						"value": "[parameters('ADF_SQL_Database_Link_properties_typeProperties_database')]"
					},
					"ADF_SQL_Database_Link_properties_typeProperties_userName": {
						"value": "[parameters('ADF_SQL_Database_Link_properties_typeProperties_userName')]"
					},
					"ADF_Storage_Link_properties_typeProperties_url": {
						"value": "[parameters('ADF_Storage_Link_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}